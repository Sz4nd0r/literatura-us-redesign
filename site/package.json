{
    "type": "module",
    "name": "literatura-us-2.0",
    "version": "1.0.0",
    "description": "Modernized Literatura.us",
    "main": "index.js",
    "scripts": {
        "build": "tailwindcss -i ./src/assets/css/input.css -o ./_site/assets/css/index.css --minify && eleventy --pathprefix=/literatura-us-redesign/ && pnpm pagefind --site _site",
        "start": "eleventy --serve --incremental",
        "debug": "DEBUG=Eleventy* eleventy",
        "index": "pagefind --site _site"
    },
    "dependencies": {
        "@11ty/eleventy": "^3.1.5",
        "@11ty/eleventy-img": "^6.0.4",
        "@tailwindcss/cli": "^4.3.0",
        "js-yaml": "^4.1.1",
        "pagefind": "^1.5.2",
        "tailwindcss": "^4.3.0"
    }
}